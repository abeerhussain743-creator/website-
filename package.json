{
  "name": "postpilot",
  "private": true,
  "version": "0.1.0",
  "description": "PostPilot AI — autonomous social media content system",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@postpilot/web --filter=@postpilot/worker",
    "dev:web": "turbo run dev --filter=@postpilot/web",
    "dev:worker": "turbo run dev --filter=@postpilot/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @postpilot/db generate",
    "db:migrate": "pnpm --filter @postpilot/db migrate",
    "db:push": "pnpm --filter @postpilot/db push",
    "db:seed": "pnpm --filter @postpilot/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
