# Local development defaults (in-memory Mongo when MONGODB_URI is empty)
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=meridian-dev-secret-change-me-in-production-32chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
SEED_ON_START=true
TRUST_PROXY=false

# Optional — only needed for live Shopify OAuth
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,read_customers,read_shopify_payments_payouts,read_inventory
SHOPIFY_API_VERSION=2024-10
