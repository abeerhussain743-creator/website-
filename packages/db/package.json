{
  "name": "@shopdata/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ./scripts/run-with-env.cjs prisma generate",
    "migrate": "node ./scripts/run-with-env.cjs prisma migrate dev",
    "push": "node ./scripts/run-with-env.cjs prisma db push",
    "seed": "node ./scripts/run-with-env.cjs tsx prisma/seed.ts",
    "seed:demo": "node ./scripts/run-with-env.cjs tsx prisma/seed-demo.ts",
    "build": "node ./scripts/run-with-env.cjs prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
