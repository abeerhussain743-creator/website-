generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum InstitutionType {
  SCHOOL
  COACHING_ACADEMY
  TRAINING_CENTER
}

enum InstitutionStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  CHURNED
}

enum PlanCode {
  STARTER
  GROWTH
  PREMIUM
  CUSTOM
}

enum SystemRole {
  OWNER
  PRINCIPAL
  ADMIN
  ACCOUNTANT
  TEACHER
  CUSTOM
}

enum StudentStatus {
  ACTIVE
  LEFT
  ALUMNI
  SUSPENDED
}

enum PreferredLanguage {
  UR
  ROMAN_UR
  EN
}

enum PreferredChannel {
  WHATSAPP_TEXT
  WHATSAPP_VOICE
  VOICE_CALL
}

enum JobFailureStatus {
  PENDING
  RETRYING
  DEAD
  RESOLVED
}

// ─── Better Auth core ────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  phone         String?
  phoneVerified Boolean   @default(false) @map("phone_verified")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  auditLogs   AuditLog[]  @relation("AuditActor")

  @@map("users")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ─── SaaS plans ──────────────────────────────────────────────────────────────

model Plan {
  id          String   @id @default(cuid())
  code        PlanCode @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entitlements Entitlement[]
  institutions Institution[]

  @@map("plans")
}

model Entitlement {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  feature   String
  enabled   Boolean  @default(true)
  limit     Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@map("entitlements")
}

model InstitutionEntitlementOverride {
  id            String   @id @default(cuid())
  institutionId String   @map("institution_id")
  feature       String
  enabled       Boolean?
  limit         Int?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, feature])
  @@index([institutionId])
  @@map("institution_entitlement_overrides")
}

// ─── Tenant core ─────────────────────────────────────────────────────────────

model Institution {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  type           InstitutionType
  status         InstitutionStatus @default(ONBOARDING)
  logoUrl        String?           @map("logo_url")
  city           String?
  timezone       String            @default("Asia/Karachi")
  currency       String            @default("PKR")
  brandPrimary   String?           @map("brand_primary")
  brandAccent    String?           @map("brand_accent")
  planId         String            @map("plan_id")
  quietHoursStart Int              @default(21) @map("quiet_hours_start")
  quietHoursEnd   Int              @default(8) @map("quiet_hours_end")
  onboardingStep String?           @map("onboarding_step")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  plan                 Plan                            @relation(fields: [planId], references: [id])
  branches             Branch[]
  memberships          Membership[]
  roles                Role[]
  terminology          TerminologyMap?
  academicSessions     AcademicSession[]
  groups               Group[]
  students             Student[]
  guardians            Guardian[]
  entitlementOverrides InstitutionEntitlementOverride[]
  auditLogs            AuditLog[]
  usageMeters          UsageMeter[]
  webhookEvents        WebhookEvent[]
  jobFailures          JobFailure[]
  tasks                Task[]

  @@index([status])
  @@index([planId])
  @@map("institutions")
}

model Branch {
  id            String    @id @default(cuid())
  institutionId String    @map("institution_id")
  name          String
  code          String?
  address       String?
  city          String?
  isPrimary     Boolean   @default(false) @map("is_primary")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships Membership[]
  groups      Group[]
  students    Student[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("branches")
}

model Role {
  id            String     @id @default(cuid())
  institutionId String     @map("institution_id")
  name          String
  systemRole    SystemRole @map("system_role")
  permissions   String[]
  isSystem      Boolean    @default(false) @map("is_system")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("roles")
}

model Membership {
  id            String    @id @default(cuid())
  institutionId String    @map("institution_id")
  userId        String    @map("user_id")
  roleId        String    @map("role_id")
  branchId      String?   @map("branch_id")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id])
  branch      Branch?     @relation(fields: [branchId], references: [id])

  @@unique([institutionId, userId])
  @@index([institutionId])
  @@index([userId])
  @@map("memberships")
}

model TerminologyMap {
  id            String   @id @default(cuid())
  institutionId String   @unique @map("institution_id")
  group         String
  subgroup      String
  learner       String
  term          String
  guardian      String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("terminology_maps")
}

// ─── Academics (lightweight Phase 0) ─────────────────────────────────────────

model AcademicSession {
  id            String    @id @default(cuid())
  institutionId String    @map("institution_id")
  name          String
  startsOn      DateTime  @map("starts_on") @db.Date
  endsOn        DateTime  @map("ends_on") @db.Date
  isCurrent     Boolean   @default(false) @map("is_current")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([institutionId])
  @@map("academic_sessions")
}

model Group {
  id            String    @id @default(cuid())
  institutionId String    @map("institution_id")
  branchId      String?   @map("branch_id")
  name          String
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      Branch?     @relation(fields: [branchId], references: [id])
  subgroups   Subgroup[]
  enrollments Enrollment[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@map("groups")
}

model Subgroup {
  id            String    @id @default(cuid())
  institutionId String    @map("institution_id")
  groupId       String    @map("group_id")
  name          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([groupId, name])
  @@index([institutionId])
  @@map("subgroups")
}

model Student {
  id            String        @id @default(cuid())
  institutionId String        @map("institution_id")
  branchId      String?       @map("branch_id")
  fullName      String        @map("full_name")
  registrationNo String?      @map("registration_no")
  photoUrl      String?       @map("photo_url")
  status        StudentStatus @default(ACTIVE)
  admittedOn    DateTime?     @map("admitted_on") @db.Date
  phone         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id])
  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@unique([institutionId, registrationNo])
  @@index([institutionId, status])
  @@index([institutionId, fullName])
  @@map("students")
}

model Guardian {
  id                String            @id @default(cuid())
  institutionId     String            @map("institution_id")
  fullName          String            @map("full_name")
  phone             String
  relation          String?
  preferredLanguage PreferredLanguage @default(ROMAN_UR) @map("preferred_language")
  preferredChannel  PreferredChannel  @default(WHATSAPP_TEXT) @map("preferred_channel")
  whatsappOptIn     Boolean           @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt   DateTime?         @map("whatsapp_opt_in_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  students    StudentGuardian[]

  @@unique([institutionId, phone])
  @@index([institutionId])
  @@map("guardians")
}

model StudentGuardian {
  id            String   @id @default(cuid())
  institutionId String   @map("institution_id")
  studentId     String   @map("student_id")
  guardianId    String   @map("guardian_id")
  isPrimary     Boolean  @default(true) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([institutionId])
  @@map("student_guardians")
}

model Enrollment {
  id                String    @id @default(cuid())
  institutionId     String    @map("institution_id")
  studentId         String    @map("student_id")
  groupId           String    @map("group_id")
  subgroupId        String?   @map("subgroup_id")
  academicSessionId String    @map("academic_session_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group           Group           @relation(fields: [groupId], references: [id])
  subgroup        Subgroup?       @relation(fields: [subgroupId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@index([institutionId])
  @@index([studentId])
  @@map("enrollments")
}

// ─── Platform ops ────────────────────────────────────────────────────────────

model Task {
  id            String    @id @default(cuid())
  institutionId String    @map("institution_id")
  title         String
  description   String?
  status        String    @default("OPEN")
  assigneeId    String?   @map("assignee_id")
  dueAt         DateTime? @map("due_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
  @@map("tasks")
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String?  @map("institution_id")
  actorId       String?  @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  diff          Json?
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  actor       User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model UsageMeter {
  id            String   @id @default(cuid())
  institutionId String   @map("institution_id")
  metric        String
  period        String
  quantity      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, metric, period])
  @@index([institutionId])
  @@map("usage_meters")
}

model WebhookEvent {
  id            String    @id @default(cuid())
  institutionId String?   @map("institution_id")
  provider      String
  eventType     String    @map("event_type")
  externalId    String?   @map("external_id")
  payload       Json
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([institutionId])
  @@map("webhook_events")
}

model JobFailure {
  id             String           @id @default(cuid())
  institutionId  String?          @map("institution_id")
  queue          String
  jobName        String           @map("job_name")
  idempotencyKey String?          @map("idempotency_key")
  payload        Json?
  error          String
  attempts       Int              @default(0)
  status         JobFailureStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId, status])
  @@index([queue, status])
  @@map("job_failures")
}
