// PostPilot AI — Prisma schema (Phase 1 proposal)
// Owner: approve before remaining Phase 1 implementation.
// PostgreSQL + pgvector. Embedding columns use Unsupported("vector").

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  CLIENT_APPROVER
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  X
  TIKTOK
}

enum SocialAccountStatus {
  CONNECTED
  NEEDS_RECONNECT
  DISCONNECTED
  ERROR
}

enum PostFormat {
  SINGLE_IMAGE
  CAROUSEL
  REEL
  STORY
  TEXT
  VIDEO
}

enum ContentPillar {
  EDUCATIONAL
  ENTERTAINMENT
  BEHIND_THE_SCENES
  TESTIMONIAL
  PRODUCT
  PROMOTIONAL
  COMMUNITY
  THOUGHT_LEADERSHIP
  UGC
  TREND
  OTHER
}

enum AccountStage {
  LAUNCH
  TRACTION
  GROWTH
  AUTHORITY
}

enum CompetitorTier {
