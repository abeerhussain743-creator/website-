# PostPilot AI — environment variables
# Copy to .env and fill in values. Never commit secrets.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://postpilot:postpilot@localhost:5432/postpilot?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000
# Set true ONLY in local/dev to enable one-click demo login (never in production)
AUTH_DEV_LOGIN=true

# Google OAuth (optional in Phase 1)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link email via Resend (optional; without it, magic-link URLs log to console in dev)
AUTH_EMAIL_FROM="PostPilot <onboarding@localhost>"
RESEND_API_KEY=

# ─── Object storage (local disk | MinIO | Cloudflare R2) ─────────────────────
# Use STORAGE_DRIVER=local for zero-deps local uploads (served at /media/*).
# Use s3 with MinIO/R2 credentials for production-like storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=postpilot
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# For local driver, this should point at the Next.js media route:
S3_PUBLIC_URL=http://localhost:3000/media

# ─── Token encryption (AES-256-GCM) — 32-byte key, base64 ────────────────────
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PostPilot

# ─── Observability (optional Phase 1) ────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Later phases ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_MODEL=gpt-4o-mini
FAL_KEY=
REPLICATE_API_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
SCRAPER_URL=http://localhost:8000
SCRAPER_API_KEY=
# Keep true until live Graph publishing is approved
PUBLISH_DRY_RUN=true
