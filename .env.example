# App
NEXT_PUBLIC_APP_NAME="Maxtrone Campus"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://maxtrone:maxtrone@localhost:5432/maxtrone?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth (staff)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (default provider + model)
AI_PROVIDER=mock
AI_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Messaging
MESSAGING_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=maxtrone-verify
WHATSAPP_APP_SECRET=

# TTS / Voice
TTS_PROVIDER=mock
VOICE_CALL_PROVIDER=mock
VAPI_API_KEY=

# Payments
PAYMENT_PROVIDER=mock
JAZZCASH_MERCHANT_ID=
EASYPAISA_STORE_ID=

# Storage (R2 / S3). Unset = local disk
STORAGE_ROOT=.data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=maxtrone
S3_FORCE_PATH_STYLE=true

# Email (staff only)
RESEND_API_KEY=
EMAIL_FROM="Maxtrone <noreply@maxtrone.local>"

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
