# Shopify App
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://shopdata:shopdata@localhost:5432/shopdata?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Encryption (32-byte hex for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Object storage (S3-compatible / MinIO). If S3_ENDPOINT is unset, local disk is used.
STORAGE_ROOT=.data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=shopdata
S3_FORCE_PATH_STYLE=true

# Set true to force dry-run Shopify writes (also auto for demo tokens)
SHOPDATA_DRY_RUN=false

# App
NEXT_PUBLIC_APP_NAME=ShopData
NEXT_PUBLIC_APP_URL=http://localhost:3000
